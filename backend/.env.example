# MongoDB
MONGO_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net/?retryWrites=true&w=majority
DB_NAME=newsaintveron

# Authentication (generate a long random secret; never commit the real value)
JWT_SECRET=replace-with-a-long-random-secret
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-strong-password

# Comma-separated browser origins allowed to call the API
CORS_ORIGINS=https://newsaintveron.vercel.app,http://localhost:3000,http://localhost:3001

# Optional transactional email via SendGrid
SENDGRID_API_KEY=
SENDER_EMAIL=
LEAD_NOTIFICATION_EMAIL=

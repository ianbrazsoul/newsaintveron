{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "create-react-app",
      "outputDirectory": "build"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "server:app"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/servicos",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/digital-experience",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/inteligencia-artificial",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/contato",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/politica-de-privacidade",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/politica-de-cookies",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/termos-de-uso",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/admin/login",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}

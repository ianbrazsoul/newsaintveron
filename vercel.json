{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "create-react-app",
      "outputDirectory": "build"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "server:app"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "Content-Security-Policy-Report-Only",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https:; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
        }
      ]
    },
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/admin/login",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/static/(.*)",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/favicon.svg",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/sitemap.xml",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/robots.txt",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/servicos",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/digital-experience",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/inteligencia-artificial",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/contato",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/politica-de-privacidade",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/politica-de-cookies",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/termos-de-uso",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/admin",
      "destination": {
        "service": "frontend"
      }
    },
    {
      "source": "/admin/login",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}

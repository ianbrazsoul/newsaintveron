{
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "create-react-app",
      "outputDirectory": "build"
    },
    "backend": {
      "root": "backend/",
      "entrypoint": "server:app"
    }
  },
  "headers": [
    {
      "source": "/static/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    {"source":"/api/(.*)","destination":{"service":"backend"}},
    {"source":"/(.*)","destination":{"service":"frontend"}}
  ]
}
